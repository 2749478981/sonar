// WeaponSoundEnhance (Sonar) 插件资源
//
// 这里只放一个图标：DLL 没有窗口，但资源管理器/属性页会读它，
// 而且把图标编进 DLL 后，以后若要做托盘图标或设置面板可以直接复用 IDI_APP。
//
// 图标文件是 icons/sonar.ico（16/32/48/64/128/256 六种尺寸）。
#include <winver.h>   // VS_FFI_FILEFLAGSMASK / VFT_DLL 等版本资源常量

#define IDI_APP 100
IDI_APP ICON DISCARDABLE "icons\\sonar.ico"

// 版本信息：显示在 DLL 属性页，同时也是"这个 DLL 是 Sonar"的明确标记。
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    2,38,4,0
 PRODUCTVERSION 2,38,4,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "Sonar"
            VALUE "FileDescription",  "Sonar - Monster Hunter: World action sound plugin"
            VALUE "FileVersion",      "2.38.4.0"
            VALUE "InternalName",     "Sonar"
            VALUE "OriginalFilename", "WeaponSoundEnhance.dll"
            VALUE "ProductName",      "Sonar"
            VALUE "ProductVersion",   "2.38.4.0"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

// Sonar 配置工具（WebView2）资源
//
// 配置工具现在只是一个 WebView2 宿主窗口，界面在 web\ 里；
// 任务栏和文件属性页仍读这里的图标与版本信息。
// 图标沿用 icons/sonar.ico 的多尺寸版本。
//
// 版本号要和 src/app.h 里的 kWseGuiVersion 保持一致（界面标题显示的是那个）。
#include <winver.h>


// 内嵌资源包（武器图标 / logo / 成就音效 coinmul.wav）：启动时解压到 %LOCALAPPDATA%\Sonar\assets，
// 通过虚拟主机 https://sonar.assets 提供给界面 —— 这样游戏目录里不再散落 png/wav。
#define IDR_ASSETS 200
IDR_ASSETS RCDATA "assets.zip"

#define IDI_APP 100
IDI_APP ICON DISCARDABLE "WeaponSoundEnhanceGUI.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    2,37,10,0
 PRODUCTVERSION 2,37,10,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "Sonar"
            VALUE "FileDescription",  "Sonar - config tool"
            VALUE "FileVersion",      "2.37.10.0"
            VALUE "InternalName",     "WeaponSoundEnhanceGUI"
            VALUE "OriginalFilename", "WeaponSoundEnhanceGUI.exe"
            VALUE "ProductName",      "Sonar"
            VALUE "ProductVersion",   "2.37.10.0"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
